{
  "name": "wattsup-energy",
  "version": "1.11.4",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "playwright test",
    "test:load": "tsx --tsconfig tsconfig.json scripts/load-ingest.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/seed.ts",
    "tempo:sync": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/tempo-sync.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "weather:sync": "tsx --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/weather-sync.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "next": "15.5.27",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "web-push": "^3.6.7",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.29"
    }
  }
}
