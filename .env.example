# Variables d'environnement de WattsUp Energy.
# Développement : copier en .env.local. Production : les renseigner dans votre orchestrateur
# (fichier .env de Docker Compose, Coolify, Portainer…). Voir le README.

# --- Obligatoires ---------------------------------------------------------------------
# Base PostgreSQL 16.
DATABASE_URL=postgres://wattsup:wattsup@localhost:5432/wattsup
# Secret de signature des sessions, 32 caractères au moins : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-dev-secret-at-least-32-characters
# Adresse publique de l'instance (liens des emails, blueprints Home Assistant).
BETTER_AUTH_URL=http://localhost:3000

# --- Facultatives ---------------------------------------------------------------------
# Migrations appliquées au démarrage (par défaut) ; off pour les gérer à la main.
# RUN_MIGRATIONS=on

# Données publiques récupérées par l'instance : calendrier Tempo (api-couleur-tempo.fr),
# météo (Open-Meteo, coordonnées arrondies de la commune) et catalogue des offres du marché
# (dépôt GitHub de comparateur-abonnements-electricite.fr). off = aucun appel sortant.
# TEMPO_SYNC=on
# WEATHER_SYNC=on
# MARKET_SYNC=on

# Inscriptions : open (par défaut), invite (code exigé) ou closed. Valeur de départ
# seulement : le réglage de l'administrateur (Administration › Utilisateurs) la remplace.
# SIGNUP_MODE=open
# Codes d'invitation acceptés en mode invite, séparés par des virgules.
# INVITE_CODES=

# Envoi d'emails (mot de passe oublié, confirmation d'une nouvelle adresse, alertes,
# contact) : MAIL_FROM et une clé d'API, Brevo de préférence, sinon Resend. Domaine de
# MAIL_FROM vérifié chez le prestataire.
# MAIL_FROM=WattsUp Energy <noreply@exemple.fr>
# BREVO_API_KEY=xkeysib-xxxxxxxx
# RESEND_API_KEY=re_xxxxxxxx

# Notifications push : clés VAPID générées une fois avec  npx web-push generate-vapid-keys
# Sans elles, l'option « Notifications » n'apparaît pas dans Mon compte. VAPID_SUBJECT :
# contact transmis aux services push (mailto:… ou https://… ; à défaut, BETTER_AUTH_URL).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@exemple.fr

# --- Développement ---------------------------------------------------------------------
# Compte de démo créé par  pnpm db:seed  (local uniquement).
DEMO_EMAIL=demo@wattsup.local
DEMO_PASSWORD=wattsup-demo-local
